# Consumer secrets / toggles (copy to .env — never commit .env)
# Automated MCP propose needs a provider + matching key.
# Failure capture, architecture scan, stub propose, review, and apply work without keys.
# SDKs for cursor / openai / gemini / groq / litellm ship with the healing package.

# cursor | openai | gemini | groq | litellm (default: cursor)
HEALING_LLM_PROVIDER=cursor

CURSOR_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LITE_LLM_KEY=
# GOOGLE_API_KEY=   # optional alias when provider=gemini

# Optional model override
# (defaults: composer-2.5 / gpt-4.1 / gemini-3.6-flash / openai/gpt-oss-120b / gpt-4o-mini)
# Older IDs such as gemini-2.5-flash and llama-3.3-70b-versatile are retired.
# HEALING_LLM_MODEL=

# Opt-in: after healable locator failures, auto-run scan → stub → MCP propose
# (read from .env automatically — no need to export every time)
# HEALING_MCP_AUTO=1

# Persistent browser cache (recommended in Cursor — sandbox /tmp caches are ephemeral)
PLAYWRIGHT_BROWSERS_PATH=.playwright-browsers
