# Optional: Cursor SDK agent executor (Phase C)
# CURSOR_API_KEY=

# Healing demos in CI / headless
# HEALING_DEMO_HEADLESS=1
# HEALING_DEMO_SLOW_MO=400

# Public demo credentials (defaults exist in page modules)
# ORANGEHRM_USER=Admin
# ORANGEHRM_PASSWORD=admin123
# SAUCEDEMO_USER=standard_user
# SAUCEDEMO_PASSWORD=secret_sauce

# Healing toggles
# HEALING_RAW_LEARNING=1
# HEALING_RAW_MCP=1
# Auto chain after healable locator failures (scan if stale → stub propose → MCP propose)
# HEALING_MCP_AUTO=1
# HEALING_REGISTRY_AUTO_APPLY=0

# Navigation / action stability on flaky public demo sites (milliseconds)
# HEALING_NAV_TIMEOUT_MS=45000
# HEALING_ACTION_TIMEOUT_MS=8000
# HEALING_READY_TIMEOUT_MS=30000
# HEALING_NAV_RETRIES=3
